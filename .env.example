# Server Configuration
PORT=3001
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# MongoDB Connection
# For local development: mongodb://localhost:27017/evelinas-flowershop
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/evelinas-flowershop?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/evelinas-flowershop

# JWT Secret (generate a strong random string for production)
# You can generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# For production, also set these:
# FRONTEND_URL=https://your-app.onrender.com
# NODE_ENV=production